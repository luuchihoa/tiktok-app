  "subtitles": [
    {
      "text": "Tin Mừng Chúa Giêsu Kitô \ntheo thánh Lu-ca.",
      "startMs": 0,
      "durationMs": 3720
    },
    {
      "text": "Khi ấy, bà Ê-li-sa-bét có \nthai được sáu tháng,",
      "startMs": 3720,
      "durationMs": 3560
    },
    {
      "text": "thì Thiên Chúa \nsai sứ thần Gáp-ri-en ",
      "startMs": 7280,
      "durationMs": 2720
    },
    {
      "text": "đến một thành miền Ga-li-lê, \ngọi là Na-da-rét,",
      "startMs": 10000,
      "durationMs": 4100
    },
    {
      "text": "gặp một trinh nữ đã thành hôn\nvới một người tên là Giu-se,",
      "startMs": 14100,
      "durationMs": 4140
    },
    {
      "text": "thuộc dòng dõi vua Đa-vít. ",
      "startMs": 18240,
      "durationMs": 2360
    },
    {
      "text": "Trinh nữ ấy tên là Ma-ri-a.",
      "startMs": 20600,
      "durationMs": 2440,
      "tokens": []
    },
    {
      "text": "Sứ thần vào nhà trinh nữ \nvà nói : Mừng vui lên,",
      "startMs": 23040,
      "durationMs": 3840
    },
    {
      "text": "hỡi Đấng đầy ân sủng, \nĐức Chúa ở cùng bà.",
      "startMs": 26880,
      "durationMs": 3840
    },
    {
      "text": " Nghe lời ấy, bà rất bối rối,",
      "startMs": 30720,
      "durationMs": 2280
    },
    {
      "text": "và tự hỏi lời chào như vậy \ncó nghĩa gì.",
      "startMs": 33000,
      "durationMs": 2560
    },
    {
      "text": "Sứ thần liền nói :",
      "startMs": 35560,
      "durationMs": 1440
    },
    {
      "text": "Thưa bà Ma-ri-a, xin đừng sợ,",
      "startMs": 37000,
      "durationMs": 2700,
      "tokens": []
    },
    {
      "text": "vì bà được đẹp lòng \nThiên Chúa.",
      "startMs": 39700,
      "durationMs": 2000
    },
    {
      "text": "Này đây bà sẽ thụ thai,",
      "startMs": 41700,
      "durationMs": 1800,
      "tokens": []
    },
    {
      "text": "sinh hạ một con trai,  ",
      "startMs": 43500,
      "durationMs": 1500,
      "tokens": []
    },
    {
      "text": "và đặt tên là Giê-su.",
      "startMs": 45000,
      "durationMs": 2000,
      "tokens": []
    },
    {
      "text": "Người sẽ nên cao cả,",
      "startMs": 47000,
      "durationMs": 1600
    },
    {
      "text": "và sẽ được gọi là \nCon Đấng Tối Cao. ",
      "startMs": 48600,
      "durationMs": 2700,
      "tokens": []
    },
    {
      "text": "Đức Chúa là Thiên Chúa \nsẽ ban cho Người ",
      "startMs": 51300,
      "durationMs": 2340
    },
    {
      "text": "ngai vàng vua Đa-vít,\ntổ tiên Người.",
      "startMs": 53640,
      "durationMs": 3640
    },
    {
      "text": "Người sẽ trị vì nhà Gia-cóp \nđến muôn đời,",
      "startMs": 57280,
      "durationMs": 2740
    },
    {
      "text": "và triều đại của Người sẽ \nvô cùng vô tận.",
      "startMs": 60020,
      "durationMs": 3740
    },
    {
      "text": "Bà Ma-ri-a thưa với sứ thần :",
      "startMs": 63760,
      "durationMs": 2060
    },
    {
      "text": "Việc ấy sẽ xảy ra thế nào,",
      "startMs": 65820,
      "durationMs": 1980
    },
    {
      "text": "vì tôi không biết đến \nviệc vợ chồng ?",
      "startMs": 67800,
      "durationMs": 2800
    },
    {
      "text": "Sứ thần đáp :",
      "startMs": 70600,
      "durationMs": 1580
    },
    {
      "text": "Thánh Thần sẽ \nngự xuống trên bà,",
      "startMs": 72180,
      "durationMs": 2000
    },
    {
      "text": "và quyền năng Đấng Tối Cao \nsẽ toả bóng trên bà ;",
      "startMs": 74180,
      "durationMs": 3380
    },
    {
      "text": "vì thế, Đấng Thánh \nsắp sinh ra ",
      "startMs": 77560,
      "durationMs": 2440
    },
    {
      "text": "sẽ được gọi là Con \nThiên Chúa.",
      "startMs": 80000,
      "durationMs": 2460,
      "tokens": []
    },
    {
      "text": "Kìa bà Ê-li-sa-bét, \nngười họ hàng với bà,",
      "startMs": 82460,
      "durationMs": 2700
    },
    {
      "text": "tuy già rồi, mà cũng đang \ncưu mang một người con trai",
      "startMs": 85160,
      "durationMs": 4340
    },
    {
      "text": "bà ấy vẫn bị mang tiếng \nlà hiếm hoi,",
      "startMs": 89500,
      "durationMs": 2520
    },
    {
      "text": "mà nay đã có thai \nđược sáu tháng,",
      "startMs": 92020,
      "durationMs": 2480
    },
    {
      "text": "vì đối với Thiên Chúa, ",
      "startMs": 94500,
      "durationMs": 1500
    },
    {
      "text": "không có gì là không \nthể làm được.",
      "startMs": 96000,
      "durationMs": 3040,
      "tokens": []
    },
    {
      "text": "Bấy giờ bà Ma-ri-a \nnói với sứ thần",
      "startMs": 99040,
      "durationMs": 2740
    },
    {
      "text": "Vâng, tôi đây \nlà nữ tỳ của Chúa,",
      "startMs": 101780,
      "durationMs": 2400
    },
    {
      "text": "xin Người thực hiện cho tôi \nnhư lời sứ thần nói.",
      "startMs": 104180,
      "durationMs": 3540
    },
    {
      "text": "Rồi sứ thần từ biệt ra đi.",
      "startMs": 107720,
      "durationMs": 2320
    }
  ]
}